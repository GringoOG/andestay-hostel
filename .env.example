# Content (local | sanity | api)
# sanity = Sanity API primary + automatic local fallback on failure/empty
NEXT_PUBLIC_CONTENT_PROVIDER=local
# NEXT_PUBLIC_CONTENT_PROVIDER=sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=nnfu4wmn
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Server-only (optional) — never expose as NEXT_PUBLIC_
# SANITY_API_TOKEN=
# NEXT_PUBLIC_CONTENT_API_BASE_URL=

# Booking (QloApps / custom)

NEXT_PUBLIC_BOOKING_ENABLED=true
NEXT_PUBLIC_BOOKING_PROVIDER=qloapps
NEXT_PUBLIC_BOOKING_EXTERNAL=true
NEXT_PUBLIC_BOOKING_BASE_URL=
NEXT_PUBLIC_BOOKING_DEFAULT_PATH=/
NEXT_PUBLIC_BOOKING_OPEN_IN_NEW_TAB=true

# Room product IDs (website slug → QloApps id_product)
# Inventory: 4 double · 3 matrimonial · 1 triple · 1 simple
NEXT_PUBLIC_BOOKING_ROOM_DOUBLE_PRODUCT_ID=1
NEXT_PUBLIC_BOOKING_ROOM_MATRIMONIAL_PRODUCT_ID=2
NEXT_PUBLIC_BOOKING_ROOM_TRIPLE_PRODUCT_ID=3
NEXT_PUBLIC_BOOKING_ROOM_SIMPLE_PRODUCT_ID=4

# Optional deep-link overrides per room
# NEXT_PUBLIC_BOOKING_ROOM_DOUBLE_URL=
# NEXT_PUBLIC_BOOKING_ROOM_MATRIMONIAL_URL=
# NEXT_PUBLIC_BOOKING_ROOM_TRIPLE_URL=
# NEXT_PUBLIC_BOOKING_ROOM_SIMPLE_URL=
